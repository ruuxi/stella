DEV-CONTEXT.md

# Local diagnostic logs (primary location is ~/.stella/logs, already ignored
# via .stella/ above; this covers any repo-relative fallback).
/state/logs/
**/state/logs/

# Workspace installs
/node_modules/
/runtime/node_modules/
/.stella-runtime-reload-state.json
# Live handshake flags between the dev runner and the Electron app: the quit
# flag tells the watcher a Cmd+Q was deliberate so it skips the auto-restart,
# and the restart flag requests the opposite. Both are per-run state that
# `startApp` deletes on launch — committing one would make a fresh clone
# start out claiming the user had already quit.
/.stella-dev-user-quit-request
/.stella-dev-restart-request
/desktop/.low-resource-build-cache.json
/desktop/.dev-electron-bundle-fingerprint.json
/desktop/.electron-dev-app.pid
/desktop/.electron-dev-runner.pid
/desktop/.electron-dev-runner.ready
/.stella-dev-splash.html
/.stella-dev-splash-main.cjs
/.stella-dev-splash.lock
/.stella-dev-splash.ready
# V8 compile cache for the dev Electron main process (machine-specific bytecode).
/.stella-dev/
/.stella-launch.log
/.stella-desktop-download.tar.zst
/.stella-native-helpers-download.tar.zst
/.stella-native-helpers-extract-*/
/claude-code-resolved-models.json
/launch.sh
/stella-install.json
/stella-install.log
/stella-release.json

# TypeScript incremental build artifacts (machine-generated; never commit).
*.tsbuildinfo

# TanStack Router temporary files (machine-generated).
/.tanstack/

# Exec worker fallback CJS cache (Node-test runtime only; Bun loads .ts directly).
runtime/kernel/exec/.exec-worker-cache/

.env.local

# Local strategy notes (never commit).
/strategy/
