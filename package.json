{
  "name": "stella",
  "private": true,
  "version": "0.0.440",
  "type": "module",
  "main": "desktop/dist-electron/desktop/electron/main.js",
  "scripts": {
    "dev": "cd desktop && vite",
    "preview": "cd desktop && vite preview",
    "build": "bun run routes:generate && cd desktop && ../node_modules/typescript-7/bin/tsc --build && vite build && node scripts/check-renderer-bundle-budget.mjs",
    "format": "bunx prettier@3.6.2 --write .",
    "format:check": "bunx prettier@3.6.2 --check .",
    "lint": "cd desktop && eslint .",
    "logs": "node desktop/scripts/open-logs.mjs",
    "test": "cd desktop && vitest",
    "test:run": "cd desktop && vitest run",
    "test:electron": "cd desktop && vitest run --config vitest.electron.config.ts",
    "test:stella-browser": "cargo test --manifest-path desktop/stella-browser/cli/Cargo.toml -- --skip test_all_documented_actions_are_handled && node --test desktop/stella-browser/extension/*.test.js desktop/stella-browser/extension/**/*.test.js && vitest run desktop/tests/runtime/kernel/browser-use/*.test.ts",
    "routes:generate": "cd desktop && bunx --package @tanstack/router-cli@1.166.40 tsr generate",
    "ipc:contract": "cd desktop && node scripts/derive-ipc-payload-contract.mjs",
    "reset": "cd desktop && node scripts/reset-dev.mjs",
    "reset:all": "cd desktop && node scripts/reset-dev.mjs --with-permissions",
    "reset:sql": "cd desktop && node scripts/reset-sql.mjs",
    "native:build": "cd desktop/native && npm install && npm run build",
    "native:download": "node desktop/scripts/download-native-helpers.mjs",
    "stella-browser:download": "node desktop/scripts/download-stella-browser.mjs",
    "workspace:create-app": "cd desktop && node scripts/create-workspace-app.mjs",
    "electron:install": "bun ./node_modules/electron/install.js",
    "deps:prewarm": "node desktop/scripts/prewarm-vite-deps.mjs",
    "electron:dev": "node desktop/scripts/ensure-stella-browser.mjs --allow-build-fallback && node desktop/scripts/electron-dev-runner.mjs",
    "electron:typecheck": "cd desktop && ../node_modules/typescript-7/bin/tsc -p tsconfig.electron.json --pretty false --noEmit && ../node_modules/typescript-7/bin/tsc -p tsconfig.preload.json --pretty false --noEmit",
    "electron:typecheck:watch": "cd desktop && concurrently -k --kill-others-on-fail \"../node_modules/typescript-7/bin/tsc -w -p tsconfig.electron.json --preserveWatchOutput --noEmit\" \"../node_modules/typescript-7/bin/tsc -w -p tsconfig.preload.json --preserveWatchOutput --noEmit\"",
    "electron:build": "bun run native:build && cd desktop && ../node_modules/typescript-7/bin/tsc --build && vite build && node scripts/check-renderer-bundle-budget.mjs && ../node_modules/typescript-7/bin/tsc -p tsconfig.electron.json && ../node_modules/typescript-7/bin/tsc -p tsconfig.preload.json && cd .. && electron-builder",
    "electron:preview": "bun run electron:dev:low-resource",
    "electron:dev:low-resource": "node desktop/scripts/electron-low-resource-build.mjs && node desktop/scripts/electron-static-preview.mjs",
    "postinstall": "node desktop/scripts/postinstall-dist-electron.mjs && node desktop/scripts/ensure-stella-browser.mjs --allow-build-fallback --best-effort",
    "check:boundary": "node runtime/scripts/check-boundary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1095.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@google/genai": "^2.13.0",
    "@legendapp/list": "3.3.3",
    "@mistralai/mistralai": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-three/fiber": "^9.6.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "0.34.52",
    "@smithy/node-http-handler": "^4.9.11",
    "@smithy/types": "^4.16.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.23",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.6.25",
    "cloudflared": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "dugite": "3.2.2",
    "esbuild": "^0.28.1",
    "gaxios": "7.3.0",
    "googleapis": "^173.0.0",
    "googleapis-common": "^8.0.3",
    "motion": "^12.42.2",
    "openai": "6.49.0",
    "partial-json": "^0.1.7",
    "picomatch": "^4.0.5",
    "proxy-agent": "^8.0.2",
    "qrcode": "^1.5.4",
    "rcedit": "^5.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.4.1",
    "recharts": "^3.10.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "uiohook-napi": "^1.5.5",
    "undici": "^8.9.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "bun-types": "1.3.14",
    "concurrently": "^10.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "29.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "axios": "^1.13.5",
    "cross-spawn": "^7.0.6",
    "gaxios": "7.3.0",
    "google-auth-library": "10.6.2",
    "qs": "^6.15.0",
    "tar": "^7.5.10",
    "vite": "8.1.5"
  },
  "optionalDependencies": {
    "mac-screen-capture-permissions": "^2.1.0"
  },
  "build": {
    "appId": "com.stella.app",
    "productName": "Stella",
    "protocols": {
      "name": "Stella Auth",
      "schemes": [
        "Stella"
      ]
    },
    "directories": {
      "output": "desktop/release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/dist/**/*",
      "desktop/dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop/resources/audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/native/out",
        "to": "native/out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/home-seed",
        "to": "runtime/home-seed",
        "filter": [
          "DREAM.md",
          "skills/**",
          "outputs/README.md"
        ]
      },
      {
        "from": "runtime/extensions",
        "to": "runtime/extensions",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/stella-browser",
        "to": "stella-browser",
        "filter": [
          "package.json",
          "bin/stella-browser.js",
          "out/**",
          "extension/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stella uses your microphone for voice conversations."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/build/icon.png"
    }
  },
  "trustedDependencies": [
    "better-sqlite3",
    "cloudflared",
    "dugite",
    "electron",
    "electron-winstaller",
    "esbuild",
    "mac-screen-capture-permissions",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "sqlite3",
    "uiohook-napi"
  ]
}
