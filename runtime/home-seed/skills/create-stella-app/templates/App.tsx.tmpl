import { useState } from "react";

/**
 * {{LABEL}} — a Stella app.
 *
 * One file by design. When this file feels cramped (well past 1k lines,
 * not before), split helpers into siblings (e.g. `{{SLUG}}.helpers.ts`,
 * `{{SLUG}}.css`). Don't preemptively split — it's cheaper to live in
 * one file until it stops working.
 *
 * `meta` is consumed by the right sidebar's Apps section: the label and
 * `createdAt` drive the library list, and picking the app mounts
 * `default` inside the panel.
 *
 * Size against the panel, not the window: it is a container
 * (`display-panel`) that can be a few hundred px wide on a wide screen,
 * so `cqi` and `@container display-panel (...)` are the units and
 * queries that read the real width — `vw` and `@media` read the window.
 *
 * Don't paint a background on the root — the shifting Stella canvas
 * sits behind everything. Tokens (`var(--foreground)`, `var(--card)`,
 * `var(--border)`, `var(--font-family-display)`, etc.) handle theming
 * automatically.
 */

export const meta = {
  label: "{{LABEL}}",
  createdAt: "{{CREATED_AT}}",
};

export default function App() {
  const [count, setCount] = useState(0);

  return (
    <div
      style={{
        width: "100%",
        height: "100%",
        boxSizing: "border-box",
        padding: "clamp(1rem, 3cqi, 2.5rem) clamp(1rem, 4cqi, 3rem)",
        color: "var(--foreground)",
        fontFamily: "var(--font-family-sans, 'Manrope', sans-serif)",
        letterSpacing: "var(--font-family-sans--default-letter-spacing, -0.02em)",
        display: "flex",
        flexDirection: "column",
        gap: "1.5rem",
        overflow: "auto",
      }}
    >
      <header style={{ display: "flex", flexDirection: "column", gap: "0.4rem" }}>
        <h1
          style={{
            margin: 0,
            fontFamily:
              "var(--font-family-display, 'Cormorant Garamond', Georgia, serif)",
            fontSize: "clamp(1.8rem, 7cqi, 3rem)",
            fontWeight: 300,
            lineHeight: 1,
            letterSpacing: "-0.04em",
          }}
        >
          {meta.label}
        </h1>
        <p
          style={{
            margin: 0,
            maxWidth: "60ch",
            color: "color-mix(in oklch, var(--foreground) 70%, transparent)",
            fontSize: 13,
            lineHeight: 1.5,
          }}
        >
          Replace this stub with the real surface. Use the full panel.
        </p>
      </header>

      <section style={{ flex: 1, minHeight: 0 }}>
        <button
          type="button"
          onClick={() => setCount((c) => c + 1)}
          style={{
            appearance: "none",
            border: "1px solid var(--border)",
            borderRadius: 12,
            padding: "10px 16px",
            background: "var(--card)",
            color: "var(--foreground)",
            font: "inherit",
            cursor: "default",
          }}
        >
          clicked {count} times
        </button>
      </section>
    </div>
  );
}
